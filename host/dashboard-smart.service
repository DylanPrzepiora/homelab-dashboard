[Unit]
Description=Collect SMART data for the dashboard container
Documentation=https://github.com/DylanPrzepiora/homelab-dashboard/blob/main/docs/smart-setup.md

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/dashboard-smart-collect
Nice=10
IOSchedulingClass=idle
NoNewPrivileges=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/dashboard
PrivateTmp=true
