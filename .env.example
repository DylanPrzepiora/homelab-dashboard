# Copy to .env (cp .env.example .env), fill in, then run ./set-password.sh.
# .env is git-ignored and holds the password hash: keep it mode 600, never commit it.

# --- Published addresses (docker-compose.yml binds ONLY to these, never to 0.0.0.0) ---
LAN_IP=192.0.2.10               # this host's LAN address (placeholder: replace)
TAILSCALE_IP=100.64.0.10        # this host's Tailscale address, `tailscale ip -4` (placeholder: replace)
DASH_PORT=8088

# --- Host paths mounted read-only into the container ---
NET_IFACE=eth0                  # NIC whose traffic counters are shown (`ip -br link`)
DATA_PATH=/mnt/data             # a filesystem to show usage for (see `mounts` in config.yaml)
SMART_DIR=/var/lib/dashboard    # directory the host collector writes smart.json into

# --- Container runtime ---
PUID=1000                       # uid:gid the container runs as (`id -u`, `id -g`); it must be able to
PGID=1000                       # read certs/ and write data/
TZ=UTC

# --- md RAID (optional) ---
# To enable the RAID panel, uncomment both lines. Without an md array leave them commented out.
#COMPOSE_FILE=docker-compose.yml:docker-compose.raid.yml
#RAID_DEVICE=md0

# --- Login (written by ./set-password.sh; there is NO default password) ---
# The app refuses to start while this is empty.
DASH_PASSWORD_HASH=
